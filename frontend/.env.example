# Explicit demo mode keeps the mocked UI available. Set privy for real wallets.
EXPO_PUBLIC_WALLET_MODE=privy
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Public key quorum ID and its one USDC transfer policy ID, NOT private keys.
EXPO_PUBLIC_PRIVY_SIGNER_ID=
EXPO_PUBLIC_PRIVY_SIGNER_POLICY_ID=
# Include /functions/v1/api for the Supabase Edge Function.
EXPO_PUBLIC_API_URL=
# Use a mobile-scoped/user RPC credential, never the backend operator's key.
EXPO_PUBLIC_RABDI_RPC_URL=
