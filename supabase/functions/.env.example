# Copy to supabase/functions/.env for local runs; set the same values on the hosted
# project with `npx supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Privy: Dashboard > Configuration > App settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The PEM public key on one line, with each newline written as \n
PRIVY_VERIFICATION_KEY=
# The backend signer's authorization private key ("wallet-auth:..."), created
# with the key quorum you add as a signer on user wallets. Never commit it.
PRIVY_AUTHORIZATION_KEY=

# Resend (trustee invite emails). Resend's onboarding@resend.dev sender is for
# testing; use an address on a domain you've verified in Resend to reach anyone.
RESEND_API_KEY=
INVITE_FROM_EMAIL="Guardian <invites@your-verified-domain.com>"
# The invite token is appended to this. Use the app's deep link or a web page.
INVITE_URL_BASE=
