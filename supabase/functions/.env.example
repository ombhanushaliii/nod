# Copy to supabase/functions/.env for local runs; set the same values on the hosted
# project with `npx supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Privy: Dashboard > Configuration > App settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The PEM public key on one line, with each newline written as \n
PRIVY_VERIFICATION_KEY=
# The backend signer's authorization private key ("wallet-auth:..."), created
# with the key quorum you add as a signer on user wallets. Never commit it.
PRIVY_AUTHORIZATION_KEY=

# Comma-separated origins allowed to call the API from the website.
WEB_ALLOWED_ORIGINS=http://localhost:8081

# Brevo (trustee invite emails): app.brevo.com > SMTP & API > API keys.
# INVITE_FROM_EMAIL must be a sender verified in Brevo (Senders, domains & IPs).
BREVO_API_KEY=
INVITE_FROM_EMAIL="Nod <invites@your-verified-sender.com>"
# The invite token is appended to this.
INVITE_URL_BASE=https://getnod.pages.dev/invite?token=

# Arkiv (Rabdi testnet). The access key goes in the RPC URL.
ARKIV_ACCESS_KEY=
# Backend wallet on Rabdi: writes OFAC/list reports and tops up new wallets
# with tGLM. Its address counts as a verified report creator. Never commit it.
ARKIV_SEED_PRIVATE_KEY=
# Shared secret the scheduled jobs send to the jobs endpoint.
JOBS_SECRET=
