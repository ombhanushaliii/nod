# Copy to services/backend/jobs/.env (git ignores it). Bun loads it by itself.
# Use the same values as supabase/functions/.env.

# Arkiv (Rabdi testnet) access key: https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
# Seed wallet on Rabdi, funded with tGLM. It writes the imported scam reports,
# and its address counts as a verified report creator. Never commit it.
ARKIV_SEED_PRIVATE_KEY=
