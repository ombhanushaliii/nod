# Vite puts a content hash in its file names under /assets, so they can be
# cached forever. public/assets/nod-logo.png is cached the same way: give it a
# new file name if it changes. index.html isn't cached, so deploys show at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The invite link carries a secret token: never send it as a referrer, don't
# cache the page, and keep it out of search results.
/invite
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Key export: no referrer, no caching, no search results, and no framing.
/export
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex
  X-Frame-Options: DENY
